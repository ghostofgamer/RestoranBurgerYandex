--- !u!114 &6924444945797984793
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2071284382358065940}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: eb15fa0e7301ff849bf4d6dcede7c12b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  data: 0
  entries:
  - Language: Turkish
    Text: "Para biriktirdin ve kendi fast food restoran\u0131n\u0131 a\xE7abildin!
      Kesinlikle en iyi y\xF6netici olacaks\u0131n, ama \u015Fimdilik hikayemize
      ba\u015Flayal\u0131m!"
    Object: {fileID: 0}
  - Language: English
    Text: You saved up money and were able to open your own fast food restaurant!
      You will definitely become the best manager, but for now, let's start our story!
    Object: {fileID: 0}
  - Language: Russian
    Text: "\u0412\u044B \u043D\u0430\u043A\u043E\u043F\u0438\u043B\u0438 \u0434\u0435\u043D\u0435\u0433
      \u0438 \u0441\u043C\u043E\u0433\u043B\u0438 \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u0441\u0432\u043E\u0439 \u0440\u0435\u0441\u0442\u043E\u0440\u0430\u043D \u0431\u044B\u0441\u0442\u0440\u043E\u0433\u043E
      \u043F\u0438\u0442\u0430\u043D\u0438\u044F! \u0412\u044B \u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E
      \u0441\u0442\u0430\u043D\u0435\u0442\u0435 \u043B\u0443\u0447\u0448\u0438\u043C
      \u043C\u0435\u043D\u0435\u0434\u0436\u0435\u0440\u043E\u043C, \u0430 \u043F\u043E\u043A\u0430
      \u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u043D\u0430\u0447\u043D\u0435\u043C
      \u043D\u0430\u0448\u0443 \u0438\u0441\u0442\u043E\u0440\u0438\u044E!"
    Object: {fileID: 0}
